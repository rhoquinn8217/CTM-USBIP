# Synthetic HID mouse presented to Windows alongside a bridged DualSense.
#
# WHY IT EXISTS. A TV has no mouse. Gyro-to-mouse reads the DualSense's motion
# (relayed as usual) and drives THIS device, which Windows binds to its stock
# HID mouse driver. Nothing physical is behind it -- the reports are generated
# on the Windows side from gyro data. USB/IP does not care whether a real
# device backs the socket; it only needs descriptors and report replies, which
# is exactly what this profile plus the mouse map provide.
#
# SHAPE. A single HID interface, one interrupt IN endpoint (0x81), boot-mouse
# protocol: 3 buttons + relative X/Y + wheel, 4-byte reports. As standard a USB
# mouse as exists, so no driver surprises.
#
# IDs. A neutral, clearly-synthetic vendor/product so it never collides with a
# real device and reads sensibly in Device Manager. 0x1D6B is the Linux
# Foundation VID commonly used for virtual USB/IP devices; product/strings mark
# it as the CTM gyro mouse.

[profile]
id = virtual_mouse
name = CTM Gyro Mouse
status = synthetic

[device_descriptor]
# 18-byte device descriptor. USB 2.0, class 0 (defined at interface), 8-byte
# EP0, VID 0x1D6B / PID 0x0002, bcdDevice 1.00, string indices 1/2/3, 1 config.
bytes = 0x12 0x01 0x00 0x02 0x00 0x00 0x00 0x08 0x6B 0x1D 0x02 0x00 0x00 0x01 0x01 0x02 0x03 0x01

[configuration_descriptor]
# 34-byte config: config(9) + interface(9) + HID(9) + endpoint(7).
#  config:    9,2, wTotalLength=0x0022(34), 1 iface, cfg#1, iConfig 0,
#             bmAttributes 0xA0 (bus-powered, remote-wakeup), 50mA (0x32).
#  interface: 9,4, iface0, alt0, 1 endpoint, class 3 (HID), sub 1 (boot),
#             proto 2 (mouse), iInterface 0.
#  HID:       9,0x21, bcdHID 1.11, country 0, 1 descriptor, type 0x22 (report),
#             wReportLength 0x0034 (52 bytes -- see mouse report descriptor).
#  endpoint:  7,5, addr 0x81 (IN 1), attr 0x03 (interrupt), wMaxPacket 8,
#             bInterval 10 (10ms -> ~100Hz poll; fine for a gyro cursor).
bytes = 0x09 0x02 0x22 0x00 0x01 0x01 0x00 0xA0 0x32 0x09 0x04 0x00 0x00 0x01 0x03 0x01 0x02 0x00 0x09 0x21 0x11 0x01 0x00 0x01 0x22 0x34 0x00 0x07 0x05 0x81 0x03 0x08 0x00 0x0A

[hid_report_descriptor]
# 52-byte standard boot-mouse report descriptor: 3 buttons (1 bit each) + 5 bits
# padding, then X, Y, wheel as three signed bytes. Report is 4 bytes:
#   [0] buttons  [1] dX (int8)  [2] dY (int8)  [3] wheel (int8)
bytes = 0x05 0x01 0x09 0x02 0xA1 0x01 0x09 0x01 0xA1 0x00 0x05 0x09 0x19 0x01 0x29 0x03 0x15 0x00 0x25 0x01 0x95 0x03 0x75 0x01 0x81 0x02 0x95 0x01 0x75 0x05 0x81 0x03 0x05 0x01 0x09 0x30 0x09 0x31 0x09 0x38 0x15 0x81 0x25 0x7F 0x75 0x08 0x95 0x03 0x81 0x06 0xC0 0xC0

[string_descriptors]
# LangID en-US (0x0409), then "CTM" (mfr), "Gyro Mouse" (product),
# "CTM-GYRO-01" (serial). Each: length, 0x03, UTF-16LE.
#  0x04 0x03 0x09 0x04                          -> LangID table
#  0x08 0x03 'C' 'T' 'M'                        -> "CTM"  (index 1)
#  0x16 0x03 'G' 'y' 'r' 'o' ' ' 'M' 'o' 'u' 's' 'e'  -> "Gyro Mouse" (index 2)
#  0x18 0x03 'C' 'T' 'M' '-' 'G' 'Y' 'R' 'O' '-' '0' '1' -> serial (index 3)
bytes = 0x04 0x03 0x09 0x04 0x08 0x03 0x43 0x00 0x54 0x00 0x4D 0x00 0x16 0x03 0x47 0x00 0x79 0x00 0x72 0x00 0x6F 0x00 0x20 0x00 0x4D 0x00 0x6F 0x00 0x75 0x00 0x73 0x00 0x65 0x00 0x18 0x03 0x43 0x00 0x54 0x00 0x4D 0x00 0x2D 0x00 0x47 0x00 0x59 0x00 0x52 0x00 0x4F 0x00 0x2D 0x00 0x30 0x00 0x31 0x00
