# Flydigi Apex 4 (VID 0x04B4, PID 0x2412) fallback profile.
# Used until CTMB_MSG_ENUM from the TV replaces it with the live composite
# enumeration captured from sysfs on webOS.

[profile]
id = flydigi_apex4_usb
name = Flydigi Apex 4
status = experimental_pass_through

[device_descriptor]
# USB 2.0, per-interface class, 04B4:2412, string indices 1/2/3.
bytes = 0x12 0x01 0x00 0x02 0x00 0x00 0x00 0x40 0xB4 0x04 0x12 0x24 0x00 0x01 0x01 0x02 0x03 0x01

