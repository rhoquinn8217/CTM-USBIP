<?xml version='1.0' encoding='utf-8'?>
<!-- CTM Bridge configuration for the vendored VirtualDisplayDriver (VDD).
     CustomEdid=true => the virtual monitor uses user_edid.bin (a verbatim copy
     of the target LG HDR 4K TV's EDID), so Windows sees the TV's identity,
     mode list, and HDR metadata. EdidCeaOverride=true additionally merges the
     <resolutions> list below into that EDID mode list (2026-07-08: adds
     2560x1440, which the LG EDID lacks). HDRPlus=true advertises HDR;
     Windows can still run the display in SDR via the HDR toggle. -->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
        <g_refresh_rate>60</g_refresh_rate>
        <g_refresh_rate>120</g_refresh_rate>
        <g_refresh_rate>144</g_refresh_rate>
    </global>
    <resolutions>
        <resolution>
            <width>1920</width>
            <height>1080</height>
            <refresh_rate>60</refresh_rate>
            <refresh_rate>120</refresh_rate>
            <refresh_rate>144</refresh_rate>
        </resolution>
        <resolution>
            <width>2560</width>
            <height>1440</height>
            <refresh_rate>60</refresh_rate>
            <refresh_rate>120</refresh_rate>
            <refresh_rate>144</refresh_rate>
        </resolution>
        <resolution>
            <width>3840</width>
            <height>2160</height>
            <refresh_rate>60</refresh_rate>
            <refresh_rate>120</refresh_rate>
            <refresh_rate>144</refresh_rate>
        </resolution>
    </resolutions>
    <options>
        <CustomEdid>true</CustomEdid>        <!-- use user_edid.bin (the LG TV EDID) -->
        <PreventSpoof>false</PreventSpoof>   <!-- false => present the TV's real manufacturer/identity -->
        <EdidCeaOverride>true</EdidCeaOverride> <!-- merge <resolutions> into the custom EDID's mode list (adds 2560x1440; identity/HDR still from user_edid.bin) -->
        <HardwareCursor>true</HardwareCursor>
        <SDR10bit>false</SDR10bit>           <!-- must be false when HDRPlus is true -->
        <HDRPlus>true</HDRPlus>              <!-- advertise HDR (Win11 23H2+); SDR still works via the HDR toggle -->
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </options>
</vdd_settings>
