<Application x:Class="CipriansBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Ciprian's Bridge dark palette (matched to the brand art / #001632) -->
        <SolidColorBrush x:Key="BgBrush" Color="#0B1524"/>
        <SolidColorBrush x:Key="CardBrush" Color="#122036"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#18294A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4DA3FF"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#2E5D96"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF2FB"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#8FA5BE"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#43D17C"/>
        <SolidColorBrush x:Key="BadBrush" Color="#E4574F"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#E0A93E"/>

        <Style x:Key="PlugButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PlugButton}">
            <Setter Property="Background" Value="#1B2C49"/>
        </Style>
    </Application.Resources>
</Application>
