<Window x:Class="CipriansBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CipriansBridge"
        Title="Ciprian's Bridge" Width="760" Height="560" MinWidth="620" MinHeight="420"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="12" Margin="0,0,16,0">
                    <Border.Background>
                        <ImageBrush ImageSource="assets/brand.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ciprian's Bridge" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="SubtitleText" Text="local Bluetooth controllers → virtual USB"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HidHidePill" CornerRadius="10" Padding="10,4" Margin="0,0,8,0" Background="#1B2C49">
                        <TextBlock x:Name="HidHideText" Text="HidHide" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Content="Refresh" Click="OnRefreshClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Device list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
            <StackPanel>
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DeviceVm}">
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                    Padding="18,14" Margin="0,0,0,10" Opacity="{Binding CardOpacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="10" Height="10" Margin="0,0,14,0" VerticalAlignment="Center"
                                             Fill="{Binding StatusBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Product}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <Border Background="#0E3A5F" CornerRadius="7" Padding="7,1" Margin="10,1,0,0">
                                                <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="Bold"
                                                           Foreground="#9CCFFF"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="0,3,0,0"
                                                   Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <CheckBox Grid.Column="2" Content="hide from games" VerticalAlignment="Center"
                                              Margin="0,0,16,0" FontSize="11.5"
                                              Foreground="{StaticResource TextDimBrush}"
                                              IsChecked="{Binding HideFromGames, Mode=TwoWay}"
                                              IsEnabled="{Binding CanToggleHide}"
                                              Visibility="{Binding HideVisibility}"/>

                                    <Button Grid.Column="3" Style="{StaticResource PlugButton}"
                                            Content="{Binding PlugLabel}" MinWidth="104"
                                            IsEnabled="{Binding CanPlug}" Click="OnPlugClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="No Bluetooth HID devices found. Pair and connect a controller, then Refresh."
                           Foreground="{StaticResource TextDimBrush}" FontSize="13" Margin="4,14,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer log -->
        <Border Grid.Row="2" Background="#0E1A2C" Padding="24,10">
            <TextBlock x:Name="LogText" Text="ready" FontSize="11.5" FontFamily="Consolas"
                       Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
